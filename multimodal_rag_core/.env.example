# ==============================================================================
# APP ROOT
# ==============================================================================
# Optional. Sets the root for .env, data/ and state.db (defaults to ~/.multimodal_rag,
# or the current dir when a .env is present). Relative paths resolve against it.
# MRAG_HOME=/absolute/path/to/appdata

# ==============================================================================
# GLOBAL MODE  (SYSTEM_MODE = content policy, ACTIVE_DB_ENGINE = storage; orthogonal)
# ==============================================================================
# DOC_ONLY_RAG   -> documents + images only (audio/video skipped at ingest);
# MULTI_MODAL_RAG -> documents + images + audio + video
SYSTEM_MODE=MULTI_MODAL_RAG
# Engine and content mode are independent: POSTGRES (with pgvector) can store
# multimodal content too. Values (case-insensitive): POSTGRES | LANCEDB.
# Blank = default for the mode (DOC_ONLY_RAG->POSTGRES, MULTI_MODAL_RAG->LANCEDB).
ACTIVE_DB_ENGINE=LANCEDB

# Desktop GUI color scheme (chat bubbles, buttons, background):
# Midnight (indigo) | Graphite (orange, default) | Ocean (navy + gold) | Daylight (light grey)
GUI_THEME=Midnight

# ==============================================================================
# HARDWARE  (CPU-only machines supported; GPU is auto-detected/optional)
# ==============================================================================
HARDWARE_DEVICE=auto

# ==============================================================================
# PURPOSE-BASED PROVIDERS  --  the single source of truth
# ==============================================================================
# Each purpose has its own provider, model and key. Keys are blank by default.
# A vendor serving multiple purposes is written for each (explicit duplication),
# e.g. a Google key goes in BOTH EMBEDDINGS_API_KEY and VLM_API_KEY.
# Run `mrag-doctor` to see the resolved configuration.
#
# SINGLE GOOGLE AI STUDIO KEY FOR EVERYTHING (recommended, free tier):
#   put the same key value in each purpose key below, and keep LLM_PROVIDER=GEMINI:
#     EMBEDDINGS_API_KEY=AIza...   VLM_API_KEY=AIza...   LLM_API_KEY=AIza...
# Google endpoint is the same for all purposes; set it once and leave the per-role
# *_BASE_URL blank:  GOOGLE_BASE_URL=https://generativelanguage.googleapis.com
# (blank everywhere = the SDK default, which is the same URL).

# ---- Embeddings (indexing + query vectors) ----
# EMBEDDING_PROVIDER=GOOGLE
# EMBEDDING_MODEL=models/gemini-embedding-001
# EMBEDDINGS_API_KEY=
# EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com
# # Valid dims: gemini-embedding-001={768,1536,3072}, text-embedding-004={256,512,768},
# #             bge-small-en-v1.5=384
# EMBEDDING_DIMENSION=768
# EMBEDDING_BATCH_SIZE=64
# EMBEDDING_NORMALIZE=true
# EMBEDDING_TASK_TYPE=RETRIEVAL_DOCUMENT
# EMBEDDING_MAX_RPM=1000
# EMBEDDING_LOCAL_FALLBACK=true


EMBEDDING_PROVIDER=LOCAL
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDINGS_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=64
EMBEDDING_NORMALIZE=true
EMBEDDING_TASK_TYPE=RETRIEVAL_DOCUMENT
EMBEDDING_MAX_RPM=1000
EMBEDDING_LOCAL_FALLBACK=true

# Token rates for this purpose, USD per 1M tokens (used for cost display).
EMBEDDING_INPUT_COST_PER_1M=0.0
EMBEDDING_OUTPUT_COST_PER_1M=0.0
# ---- Local embedding alternatives (sentence-transformers, offline, "local" on
# ---- the usage panel). Needs: pip install sentence-transformers
# ---- Option A: all-MiniLM-L6-v2 (fast, 384 dims) ----
#EMBEDDING_PROVIDER=LOCAL
#EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
#EMBEDDINGS_API_KEY=
#EMBEDDING_BASE_URL=
#EMBEDDING_DIMENSION=384
#EMBEDDING_BATCH_SIZE=64
#EMBEDDING_NORMALIZE=true
#EMBEDDING_TASK_TYPE=RETRIEVAL_DOCUMENT
#EMBEDDING_MAX_RPM=1000
#EMBEDDING_LOCAL_FALLBACK=true
# ---- Option B: bge-small-en-v1.5 (better quality, 384 dims) ----
#EMBEDDING_PROVIDER=LOCAL
#EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
#EMBEDDINGS_API_KEY=
#EMBEDDING_BASE_URL=
#EMBEDDING_DIMENSION=384
#EMBEDDING_BATCH_SIZE=64
#EMBEDDING_NORMALIZE=true
#EMBEDDING_TASK_TYPE=RETRIEVAL_DOCUMENT
#EMBEDDING_MAX_RPM=1000
#EMBEDDING_LOCAL_FALLBACK=true
# ---- Option C: EmbeddingGemma 2 (Google, Oct 2026 — text/code + vision + audio
# ---- in one 768d space; needs sentence-transformers>=6.1.0). One checkpoint,
# ---- :suffix picks encoders (same vector space, mix freely):
# ----   :text-only   Text & Code only, 270M  (smallest, ~191MB quantized)
# ----   :text-vision Text + Vision (images & video), 440M
# ----   :text-audio  Text + Audio, 570M
# ----   :full        Full Multimodal (all), 740M (~567MB quantized)
# ---- MRL truncation: EMBEDDING_DIMENSION in {768,512,256,128} (256 keeps most
# ---- quality at 1/3 storage; 128 for text-only shortlisting). Changing the
# ---- dimension needs File -> Reset index + re-ingest.
# ---- NOT bundled (Docker/exe/code ship no weights): first run downloads from
# ---- HuggingFace into the HF cache (Docker persists via /data/hf_cache).
# ---- Gated repo: 1) accept license at
# ---- https://huggingface.co/google/embeddinggemma-2
# ---- 2) huggingface-cli login  3) restart with internet (auto-downloads) or:
# ---- huggingface-cli download google/embeddinggemma-2
# ---- Needs recent libraries (venv active):
# ---- pip install -U "sentence-transformers>=6.1.0" transformers huggingface_hub
# ---- (an outdated transformers fails with "does not recognize this architecture").
#EMBEDDING_PROVIDER=LOCAL
#EMBEDDING_MODEL=google/embeddinggemma-2:text-only
#EMBEDDINGS_API_KEY=
#EMBEDDING_BASE_URL=
#EMBEDDING_DIMENSION=768
#EMBEDDING_BATCH_SIZE=64
#EMBEDDING_NORMALIZE=true
#EMBEDDING_TASK_TYPE=RETRIEVAL_DOCUMENT
#EMBEDDING_MAX_RPM=1000
#EMBEDDING_LOCAL_FALLBACK=true

# ---- Vision / VLM (standalone image captions + video keyframe captions) ----
VLM_PROVIDER=GEMINI
VLM_MODEL=gemini-3.5-flash-lite
VLM_API_KEY=
VLM_BASE_URL=https://generativelanguage.googleapis.com

# VLM_PROVIDER=DEEPSEEK
# VLM_MODEL=deepseek-flash
# VLM_API_KEY=
# VLM_BASE_URL=https://api.deepseek.com


# Local fallback when the primary VLM is rate-limited (needs a GPU for the 7B model).
VLM_FALLBACK_PROVIDER=OLLAMA
VLM_FALLBACK_MODEL=qwen2-vl:7b
VLM_ENABLE_LOCAL_FALLBACK=true
VLM_ALLOW_CPU_FALLBACK=false
VLM_CPU_FALLBACK_MODEL=HuggingFaceTB/SmolVLM-256M-Instruct
# Default models when PROVIDER=LOCAL and MODEL is blank (must be pulled in Ollama).
VLM_LOCAL_MODEL=qwen2-vl:7b
# Token rates for this purpose, USD per 1M tokens (used for cost display).
VLM_INPUT_COST_PER_1M=0.0
VLM_OUTPUT_COST_PER_1M=0.0
# Alternatives — same keys, different provider (needs `pip install anthropic` for Muse):
#   DeepSeek: VLM_PROVIDER=DEEPSEEK, VLM_MODEL=deepseek-flash, VLM_API_KEY=sk-...
#   OpenAI:  VLM_PROVIDER=OPENAI,  VLM_MODEL=gpt-4o-mini, VLM_API_KEY=sk-...
#   Muse: VLM_PROVIDER=ANTHROPIC, VLM_MODEL=claude-3-5-sonnet-latest, VLM_API_KEY=sk-ant-...
#   Grok:    VLM_PROVIDER=XAI,     VLM_MODEL=grok-3-mini, VLM_API_KEY=xai-...
#   (leave VLM_BASE_URL blank for vendor defaults; Meta/Llama runs via Ollama/LOCAL)

# ---- Text / LLM (per-file summaries + synthesized answers) ----
# Default: Gemini, so one Google AI Studio key can serve all three purposes.
LLM_PROVIDER=GEMINI
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com
# Default model when LLM_PROVIDER=LOCAL and LLM_MODEL is blank (pull in Ollama first).
LLM_LOCAL_MODEL=llama3.1:8b
# Sampling temperature for synthesized RAG answers only (0.0 = deterministic:
# same evidence, same verdict). Summaries/captions keep vendor defaults.
# Range 0.0-1.0 (portable across Gemini/DeepSeek/OpenAI/Anthropic/Ollama).
LLM_TEMPERATURE=0.1

# LLM_PROVIDER=DEEPSEEK
# LLM_MODEL=deepseek-flash
# LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com


# Alternative — DeepSeek (text only): set LLM_PROVIDER=DEEPSEEK,
#   LLM_MODEL=deepseek-chat, LLM_API_KEY=sk-..., LLM_BASE_URL=https://api.deepseek.com
# Alternative — OpenAI: LLM_PROVIDER=OPENAI, LLM_MODEL=gpt-4o-mini, LLM_API_KEY=sk-...
# Alternative — Muse: LLM_PROVIDER=ANTHROPIC, LLM_MODEL=claude-3-5-sonnet-latest,
#   LLM_API_KEY=sk-ant-... (needs `pip install anthropic`)
# Alternative — Grok: LLM_PROVIDER=XAI, LLM_MODEL=grok-3-mini, LLM_API_KEY=xai-...
# Alternative — Meta/Llama locally: LLM_PROVIDER=LOCAL (or OLLAMA), LLM_MODEL=llama3.1:8b
# Token rates for this purpose, USD per 1M tokens (used for cost display).
LLM_INPUT_COST_PER_1M=0.0
LLM_OUTPUT_COST_PER_1M=0.0
ENABLE_DOCUMENT_SUMMARIES=true
SUMMARY_MAX_CHARS=4000

# ---- Local runner (Ollama), used for OLLAMA providers above (no API key) ----
OLLAMA_BASE_URL=http://localhost:11434

# ---- All-local example (no API keys, no cloud calls; usage panel shows "local").
# ---- Needs: Ollama running with the models pulled + pip install sentence-transformers.
# ---- Uncomment this block and comment out the GOOGLE/DEEPSEEK values above.
#EMBEDDING_PROVIDER=LOCAL
#EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
#EMBEDDING_DIMENSION=384
#LLM_PROVIDER=LOCAL
#LLM_MODEL=llama3.1:8b
#VLM_PROVIDER=LOCAL
#VLM_MODEL=qwen2-vl:7b
# (blank MODEL falls back to LLM_LOCAL_MODEL / VLM_LOCAL_MODEL defaults)

# ---- DEPRECATED vendor-centric names (kept as fallbacks; prefer the roles above) ----
# If a purpose's *_API_KEY is blank, these are used for the matching provider.
# GOOGLE_API_KEY=
# GOOGLE_BASE_URL=https://generativelanguage.googleapis.com   # shared by Google/Gemini roles
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# TEXT_LLM_PROVIDER=DEEPSEEK
# TEXT_LLM_MODEL=deepseek-chat
# VISION_LLM_PROVIDER=GEMINI
# VISION_LLM_MODEL=gemini-3.8-flash

# ==============================================================================
# RERANKER  (tiny cross-encoder on CPU; auto-disabled if CPU use not allowed)
# ==============================================================================
RERANKER_PROVIDER=LOCAL
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_TOP_N=15
RERANKER_ALLOW_CPU=true

# ==============================================================================
# RETRIEVAL  (summary-aware hybrid: vector + corpus-wide lexical + summary via RRF)
# ==============================================================================
# chunk = passage-level ANN; summary = file-level only; hybrid = RRF fusion (recommended)
SEARCH_MODE=hybrid
SEARCH_TOP_K=5
HYBRID_RRF_K=50

# ==============================================================================
# DATABASE (Postgres)
# ==============================================================================
# Used only when the engine resolves to POSTGRES. Matches docker-compose.yml defaults:
#   docker compose up -d postgres   (or: make pg-up)
# The database itself is created automatically on first run if missing.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=rag_db
# Optional full-DSN override (managed DBs, sockets, extra params).
# Blank = built from the components above.
POSTGRES_URL=
LANCEDB_DIR=./data/lancedb_lakehouse
DB_TABLE_NAME=chunks
# IVF_PQ is lossy and needs training data; IVF_FLAT is more accurate for small/medium sets.
LANCEDB_INDEX_TYPE=IVF_FLAT
LANCEDB_NUM_PARTITIONS=256

# ==============================================================================
# DOCUMENT PARSING  (Docling - free/local, CPU-friendly)
# ==============================================================================
DOC_USE_OCR=true
DOC_CHUNK_SIZE=800
DOC_CHUNK_OVERLAP=100

# ==============================================================================
# MULTIMODAL FRAME SAMPLING
# ==============================================================================
# HYBRID = shot detection + forced min-interval floor + rate cap (recommended)
# SCENE  = pure shot-change detection; FPS = fixed frames per second
MM_FRAME_STRATEGY=HYBRID
MM_FRAME_SAMPLING_FPS=2
MM_SCENE_THRESHOLD=0.30
MM_SCENE_MIN_INTERVAL_SEC=8.0
MM_MAX_KEYFRAMES_PER_MIN=30
MM_DEDUP_HASH_THRESHOLD=6
MM_RESIZE_FRAME=true
MM_TARGET_HEIGHT=360
MM_JPEG_QUALITY=80

# ==============================================================================
# VLM REQUEST THROTTLING / BATCHING / CACHING
# ==============================================================================
VLM_BATCH_SIZE=8
VLM_MAX_RPM=15
VLM_MAX_RPD=1500
VLM_RETRY_MAX=5
VLM_BACKOFF_BASE=2.0
ENABLE_CACHE=true
VLM_CACHE_DIR=./data/vlm_cache

# ==============================================================================
# INGESTION  (watched inbox + CLI + periodic scan)
# ==============================================================================
DATA_DIR=./data
INBOX_DIR=./data/inbox
PROCESSING_DIR=./data/processing
PROCESSED_DIR=./data/processed
FAILED_DIR=./data/failed
# Ingest queue/state database. Default lives with the app (one queue per app
# folder; travels with a portable build). Leave BLANK to key one per-user file
# by the vector store instead, so multiple app folders on the same DB share the
# same records — but then do NOT expect two app roots on one DB to keep separate
# queues (they will share; use a different POSTGRES_DB/LANCEDB_DIR to separate).
STATE_DB_PATH=./data/state.db
# watch = filesystem events (with scan fallback); scan = periodic poll only; manual = CLI only
INGESTION_MODE=watch
WATCH_POLL_INTERVAL_SEC=5
FILE_STABLE_SECONDS=15
WORKER_COUNT=2
MAX_INGEST_RETRIES=3
INGEST_IGNORE_EXTENSIONS=.part,.crdownload,.tmp,.swp,.lock

# ==============================================================================
# AUDIO TRANSCRIPTION  (faster-whisper / CTranslate2 - free/local, CPU-friendly)
# ==============================================================================
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_LANGUAGE=

# ==============================================================================
# TOKEN / COST TRACKING  (USD per 1M tokens; free tiers = 0)
# ==============================================================================
# Per-purpose rates live next to each purpose above (EMBEDDING/VLM/LLM_*_COST_PER_1M).
# The two provider rates below are legacy fallbacks; a per-model JSON map takes
# precedence over everything (a ["in", "out"] list works as shorthand).
DEEPSEEK_INPUT_COST_PER_1M=0.27
DEEPSEEK_OUTPUT_COST_PER_1M=1.10
GEMINI_INPUT_COST_PER_1M=0.0
GEMINI_OUTPUT_COST_PER_1M=0.0
# Per-model rates (JSON) override the provider rates above for the named model.
# A ["input", "output"] list works as shorthand. Models with neither show
# "rate missing" on the usage panel (Ollama/local models show "local").
# Example:
# MODEL_TOKEN_RATES={"gemini-3.8-flash": {"input": 0.075, "output": 0.30}, "gemini-embedding-001": [0.0, 0.0], "deepseek-chat": [0.27, 1.10]}
MODEL_TOKEN_RATES={}
